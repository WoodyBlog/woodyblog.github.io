<div class="autopagerize_page_element"><div class="content"><h2>Archive</h2><% var years = {}; page.posts.forEach(function(post) { var year = date(post.date, 'YYYY'); if (!years[year]) years[year] = []; years[year].push(post); }); %><% Object.keys(years).sort().reverse().forEach(function(year) { %><h3><%= year %></h3><ul><% years[year].forEach(function(post) { %><li><span class="date"><%= date(post.date, 'MM-DD') %></span>&nbsp;<a href="<%- url_for(post.path) %>"><%= post.title %></a></li><% }); %></ul><% }); %></div></div>
