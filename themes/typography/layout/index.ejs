<div class="autopagerize_page_element"><div class="content"><% page.posts.forEach(function(post) { %><div class="post-container"><p class="post-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></p><p class="post-meta"><span class="date meta-item">Posted at&nbsp;<%= date(post.date, 'YYYY-MM-DD') %></span><span class="meta-item"><i class="fa fa-tag"></i><span>&nbsp;</span><% post.tags.forEach(function(tag, i) { %><a class="a-tag" href="<%- url_for(tag.path) %>" title="<%= tag.name %>"><%= tag.name %></a><span>&nbsp;</span><% }); %></span></p><p class="post-abstract"><%- post.excerpt || strip_html(post.content).substring(0, 200) + '...' %></p></div><% }); %><div class="pagination no-margin-bottom"><p class="clearfix"><p> Page <%= page.current %> / <%= page.total %> &nbsp;</p><p><span class="pre pagbuttons"><% if (page.prev) { %><i class="fa fa-angle-double-left"></i>&nbsp;<a role="navigation" href="<%- url_for(page.prev_link) %>" aria-label="Previous">Previous</a><% } %></span><span>&nbsp;</span><span class="next pagbuttons"><% if (page.next) { %><a role="navigation" href="<%- url_for(page.next_link) %>" aria-label="Next">Next</a>&nbsp;<i class="fa fa-angle-double-right"></i><% } %></span></p></p></div></div></div>
