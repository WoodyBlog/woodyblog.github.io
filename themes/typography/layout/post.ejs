<div class="autopagerize_page_element"><div class="content"><div class="post-page"><div class="post-container"><p class="post-title"><a><%= page.title %></a></p><p class="post-meta"><span class="date meta-item">Posted at&nbsp;<%= date(page.date, 'YYYY-MM-DD') %></span><span class="meta-item"><i class="fa fa-tag"></i><span>&nbsp;</span><% page.tags.forEach(function(tag, i) { %><a class="a-tag" href="<%- url_for(tag.path) %>" title="<%= tag.name %>"><%= tag.name %></a><span>&nbsp;</span><% }); %></span></p><div class="post-abstract"><%- page.content %></div></div><div class="share"><span>Share</span>&nbsp;<span class="soc"><a class="fa fa-twitter" target="_blank" rel="noopener" href="http://twitter.com/home?status=<%- encodeURI(config.url + '/' + page.path) %>%20<%= config.title %>%20<%= page.title %>"></a></span></div><div class="pagination"><p class="clearfix"><% if (page.prev) { %><span class="pre pagbuttons"><a role="navigation" href="<%- url_for(page.prev.path) %>" title="<%= page.prev.title %>"><i class="fa fa-angle-double-left"></i>&nbsp;Previous post: <%= page.prev.title %></a></span><% } %><% if (page.next) { %><span class="next pagbuttons"><a role="navigation" href="<%- url_for(page.next.path) %>" title="<%= page.next.title %>">Next post: <%= page.next.title %>&nbsp;<i class="fa fa-angle-double-right"></i></a></span><% } %></p></div></div></div></div>
