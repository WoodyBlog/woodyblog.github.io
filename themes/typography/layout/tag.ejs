<div class="autopagerize_page_element"><div class="content"><h2>Tags</h2><div class="tags-list"><% site.tags.forEach(function(tag) { %><a href="<%- url_for(tag.path) %>" class="tag-item"><%= tag.name %> (<%= tag.length %>)</a>&nbsp;<% }); %></div><% if (page.tag) { %><h3><%= page.tag %></h3><ul><% page.posts.forEach(function(post) { %><li><span class="date"><%= date(post.date, 'YYYY-MM-DD') %></span>&nbsp;<a href="<%- url_for(post.path) %>"><%= post.title %></a></li><% }); %></ul><% } %></div></div>
